{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://razermate.local/schemas/profiles.schema.json",
  "title": "RazerMate v2 profiles.json",
  "description": "唯一事实源。后台程序是通用解释器：按键 ID 表、动作串、灯效、匹配规则全部来自本文件，程序不内置任何按键语义。additionalProperties 一律开放，新增配置选项无需重编译。",
  "type": "object",
  "required": ["schema", "device", "service", "base", "profiles"],
  "properties": {
    "schema": { "const": 3, "description": "契约版本号，v2 当前为 3" },
    "$schema": { "type": "string" },
    "updated_at": { "type": "string" },

    "device": {
      "type": "object",
      "required": ["buttons", "led_regions"],
      "properties": {
        "name": { "type": "string" },
        "vid": { "type": "integer" },
        "pid": { "type": "integer" },
        "buttons": {
          "type": "object",
          "description": "名称→物理按钮。程序只读这张表来解析绑定里的键名，不内置按钮表。换设备只改这里。",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["id", "native"],
            "properties": {
              "id": { "type": "integer", "minimum": 0, "maximum": 255 },
              "zh": { "type": "string" },
              "native": { "type": "string", "description": "恢复该键出厂功能时要写的动作串" },
              "tags": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "led_regions": {
          "type": "object",
          "description": "灯区名称→设备 region ID",
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "caps": { "type": "object", "description": "设备能力上限，供 AI 生成与校验参考" }
      }
    },

    "service": {
      "type": "object",
      "properties": {
        "autostart": { "type": "boolean" },
        "background": { "type": "boolean" },
        "headless": { "type": "boolean" },
        "tray_icon": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["online"] },
        "driver_only": { "type": "boolean" },
        "never_touch_onboard_profiles": { "type": "boolean" },
        "single_instance": { "type": "boolean" },
        "match_by": { "type": "array", "items": { "type": "string", "enum": ["foreground_exe", "window_title", "process_path"] } },
        "fallback": { "type": "string", "description": "没有 profile 命中时使用的 profile id" },
        "on_error": { "type": "string", "enum": ["keep_last", "revert_base", "stop"] },
        "on_device_missing": { "type": "string", "enum": ["retry", "ignore"] },
        "poll_ms": { "type": "integer", "minimum": 50 },
        "config_watch_ms": { "type": "integer", "minimum": 50 },
        "config_debounce_ms": { "type": "integer", "minimum": 0 },
        "reapply_on_device_arrival": { "type": "boolean" },
        "reapply_on_wake": { "type": "boolean" },
        "reapply_interval_ms": { "type": "integer", "minimum": 0 },
        "restore_on_exit": { "type": "boolean" },
        "log": { "type": "object" },
        "p0": { "type": "object" },
        "macros": { "type": "object" }
      }
    },

    "actions": { "type": "object", "description": "动作语法字典（人/AI 文档，程序不解析此表）" },
    "lighting_effects": { "type": "object" },
    "macro_steps": { "type": "object" },

    "macros": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/macro" }
    },

    "base": { "$ref": "#/definitions/layer" },

    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scope", "overrides"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "scope": { "type": "string", "enum": ["global", "app"] },
          "enabled": { "type": "boolean" },
          "priority": { "type": "integer" },
          "match": { "$ref": "#/definitions/match" },
          "note": { "type": "string" },
          "overrides": { "$ref": "#/definitions/partial_layer" }
        }
      }
    }
  },

  "definitions": {
    "binding": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "equivalent": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" },
        "derived_from": { "type": "string" },
        "locked": { "type": "boolean", "description": "仅给人/AI 看的提示，程序不因它为 true 而拒绝修改" }
      }
    },
    "light_setting": {
      "type": "object",
      "required": ["effect", "brightness"],
      "properties": {
        "effect": { "type": "string", "enum": ["static", "spectrum", "wave"] },
        "rgb": { "type": "string", "pattern": "^[0-9a-fA-F]{6}$" },
        "mode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "speed": { "type": "integer", "minimum": 0, "maximum": 255 },
        "brightness": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "sensor": {
      "type": "object",
      "properties": {
        "dpi": {
          "description": "单值同时设 X/Y，或 [x, y] 分开设",
          "oneOf": [
            { "type": "integer", "minimum": 100, "maximum": 26000 },
            { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 26000 }, "minItems": 2, "maxItems": 2 }
          ]
        },
        "polling": { "type": "integer", "enum": [125, 500, 1000] }
      }
    },
    "match": {
      "type": "object",
      "properties": {
        "exe": { "type": "array", "items": { "type": "string" } },
        "title_contains": { "type": "array", "items": { "type": "string" } },
        "path_contains": { "type": "array", "items": { "type": "string" } },
        "case_sensitive": { "type": "boolean" }
      }
    },
    "macro": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "id": { "type": ["integer", "null"], "description": "设备宏区 ID；null 表示由程序分配并回填" },
        "trigger": { "type": "string", "enum": ["once", "hold", "toggle"] },
        "equivalent": { "type": "string" },
        "note": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "layer": {
      "type": "object",
      "required": ["bindings", "sensor", "lighting"],
      "description": "基础层：bindings 必须写全 device.buttons 里的每个键；sensor 与 lighting 也要写全灯区。",
      "properties": {
        "bindings": { "type": "object", "additionalProperties": { "$ref": "#/definitions/binding" } },
        "sensor": { "$ref": "#/definitions/sensor" },
        "lighting": { "type": "object", "additionalProperties": { "$ref": "#/definitions/light_setting" } }
      }
    },
    "partial_layer": {
      "type": "object",
      "description": "覆盖层：只需写要改的键/灯区，其余继承 base。允许覆盖任意按键，包括 left/right/wheelup/wheeldown。",
      "properties": {
        "bindings": { "type": "object", "additionalProperties": { "$ref": "#/definitions/binding" } },
        "sensor": { "$ref": "#/definitions/sensor" },
        "lighting": { "type": "object", "additionalProperties": { "$ref": "#/definitions/light_setting" } }
      }
    }
  }
}
