# 构建产物（统一落到 dev/target，见 .cargo/config.toml）
/dev/target/
# 旧的根级 target，迁移期保留忽略，避免误入版本控制
/target/

# 用户目录里的可执行文件不入库；脚本、配置、文档要入库
/RazerMate/*.exe

*.log
*.pdb
*.pyc
__pycache__/

.env
.env.*
!.env.example
*.local
*.local.*
credentials.local.*
local_secrets.*

*.pem
*.key
id_rsa*
id_ed25519*
known_hosts*
authorized_keys*

.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地工作记忆（辅助日志，不入库）
.workbuddy/
